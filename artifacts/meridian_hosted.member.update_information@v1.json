{
  "schema_version": "1.0.0",
  "id": "meridian_hosted.member.update_information",
  "version": 1,
  "name": "Update member contact information",
  "description": "Sign on to the MERIDIAN CORE servicing console as operator teller1. Look up member 102777 by member number and open their record. From that record, click through to Update Member Information -- reach it by clicking links on the page, never by typing a member URL. Set the e-mail field to k.johnson@example.com, the phone field to 555-0142 and the mailing address to '88 Cornerstone Ave, Springfield'. Set all three explicitly. Save the changes, then read back the e-mail address the host shows as stored.",
  "app": {
    "product": "meridian-hosted",
    "product_version": "v4.2.1",
    "tenant": null,
    "entry_url": "https://web-sample.interface-hiring.com/signon",
    "surface": "legacy_web"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777'.",
      "example": "102777",
      "pattern": "^\\d{6}$",
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "operator_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'teller1'.",
      "example": "teller1",
      "pattern": null,
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "email",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'k.johnson@example.com'.",
      "example": "k.johnson@example.com",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "phone",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '555-0142'.",
      "example": "555-0142",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "address",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '88 Cornerstone Ave, Springfield'.",
      "example": "88 Cornerstone Ave, Springfield",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "operator_password",
      "type": "string",
      "required": true,
      "description": "Operator credential.",
      "example": null,
      "pattern": null,
      "sensitivity": "restricted",
      "secret": true
    }
  ],
  "outputs": [
    {
      "name": "stored_email",
      "type": "string",
      "description": "",
      "extract": {
        "target": {
          "described_as": "Read back the stored e-mail address from the member record",
          "frame": {
            "kind": "top",
            "value": null
          },
          "strategies": [
            {
              "kind": "row_scoped_cell",
              "row_contains": "E-mail:",
              "cell_index": 1,
              "exact_row_text": false
            }
          ],
          "rationale": "Anchored on the row containing 'E-mail:' rather than an absolute row index, so inserting or reordering rows does not read the wrong value."
        },
        "source": "text",
        "attribute": null,
        "transform": {
          "kind": "strip",
          "pattern": null
        }
      },
      "required": true,
      "after_step": "return_to_member_record",
      "sensitivity": "restricted"
    }
  ],
