      "message": "The host refused the transfer as entered and no funds moved. This is an answer to the request, not a breakdown of the automation."
    },
    {
      "id": "field_validation_failed",
      "description": "The host refused one or more submitted field values as malformed.",
      "detect": {
        "kind": "text_present",
        "frame": {
          "kind": "top",
          "value": null
        },
        "text": "Please correct the following",
        "case_sensitive": false
      },
      "classification": "business_outcome",
      "outcome_code": "INPUT_REJECTED",
      "recovery": null,
      "escalate": false,
      "message": "The host rejected the values submitted. Nothing was changed; the individual reasons are listed on the screen."
    },
    {
      "id": "supervisor_override_required",
      "description": "The operator profile is not entitled to this function.",
      "detect": {
        "kind": "text_present",
        "frame": {
          "kind": "top",
          "value": null
        },
        "text": "is not authorized to perform this",
        "case_sensitive": false
      },
      "classification": "business_outcome",
      "outcome_code": "SUPERVISOR_OVERRIDE_REQUIRED",
      "recovery": null,
      "escalate": false,
      "message": "This function needs a supervisor profile. Classified as an outcome rather than a failure because the caller can act on it -- re-invoke with supervisor credentials -- whereas escalating to a human would not help unless that human is themselves a supervisor."
    },
