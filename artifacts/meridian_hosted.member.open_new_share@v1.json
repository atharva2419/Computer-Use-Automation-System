{
  "schema_version": "1.0.0",
  "id": "meridian_hosted.member.open_new_share",
  "version": 1,
  "name": "Open a new share",
  "description": "Sign on to the MERIDIAN CORE servicing console as operator teller1. Look up member 102777 by member number and open their record. Open the Open New Share screen. Set the share type dropdown to MMKT and the initial deposit field to 25.00. Both fields must be set explicitly, including the dropdown even if it already shows the value you want. Continue to the confirmation screen and post it to open the share. Then read back the account number of the share that was created. Stay within the member servicing screens; do not visit System Settings.",
  "app": {
    "product": "meridian-hosted",
    "product_version": "v4.2.1",
    "tenant": null,
    "entry_url": "https://web-sample.interface-hiring.com/signon",
    "surface": "legacy_web"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777'.",
      "example": "102777",
      "pattern": "^\\d{6}$",
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "operator_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'teller1'.",
      "example": "teller1",
      "pattern": null,
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "share_type",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'MMKT'.",
      "example": "MMKT",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "opening_deposit",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '25.00'.",
      "example": "25.00",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "operator_password",
      "type": "string",
      "required": true,
      "description": "Operator credential.",
      "example": null,
      "pattern": null,
      "sensitivity": "restricted",
      "secret": true
    }
  ],
  "outputs": [
    {
      "name": "new_share_account_number",
      "type": "string",
      "description": "",
      "extract": {
        "target": {
          "described_as": "Read the new share account number created",
          "frame": {
            "kind": "top",
            "value": null
          },
          "strategies": [
            {
              "kind": "row_scoped_cell",
              "row_contains": "New Share ID:",
              "cell_index": 1,
              "exact_row_text": false
            }
          ],
          "rationale": "Anchored on the row containing 'New Share ID:' rather than an absolute row index, so inserting or reordering rows does not read the wrong value."
        },
        "source": "text",
        "attribute": null,
        "transform": {
          "kind": "strip",
          "pattern": null
        }
      },
      "required": true,
      "after_step": "post_the_share_opening",
      "sensitivity": "restricted"
    }
  ],
