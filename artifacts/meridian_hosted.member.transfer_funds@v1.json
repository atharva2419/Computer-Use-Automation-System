{
  "schema_version": "1.0.0",
  "id": "meridian_hosted.member.transfer_funds",
  "version": 1,
  "name": "Transfer funds between a member's shares",
  "description": "Sign on to the MERIDIAN CORE servicing console as operator teller1. Look up member 102777 by member number and open their record. Then use Funds Transfer to move 1.00 from share 102777-MMKT-3 to share 102777-MMKT-4 with the memo capability-recording. Continue to the confirmation screen and post the transfer. Read back the confirmation reference the host returns.",
  "app": {
    "product": "meridian-hosted",
    "product_version": "v4.2.1",
    "tenant": null,
    "entry_url": "https://web-sample.interface-hiring.com/signon",
    "surface": "legacy_web"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777'.",
      "example": "102777",
      "pattern": "^\\d{6}$",
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "operator_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'teller1'.",
      "example": "teller1",
      "pattern": null,
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "from_share",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777-MMKT-3'.",
      "example": "102777-MMKT-3",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "to_share",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777-MMKT-4'.",
      "example": "102777-MMKT-4",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "amount",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '1.00'.",
      "example": "1.00",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "memo",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'capability-recording'.",
      "example": "capability-recording",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "operator_password",
      "type": "string",
      "required": true,
      "description": "Operator credential.",
      "example": null,
      "pattern": null,
      "sensitivity": "restricted",
      "secret": true
    }
  ],
  "outputs": [
    {
      "name": "confirmation_reference",
      "type": "string",
      "description": "",
      "extract": {
        "target": {
          "described_as": "Read the confirmation reference number",
          "frame": {
            "kind": "top",
            "value": null
          },
          "strategies": [
            {
              "kind": "row_scoped_cell",
              "row_contains": "Confirmation:",
              "cell_index": 1,
              "exact_row_text": false
            }
          ],
          "rationale": "Anchored on the row containing 'Confirmation:' rather than an absolute row index, so inserting or reordering rows does not read the wrong value."
        },
        "source": "text",
        "attribute": null,
        "transform": {
          "kind": "strip",
          "pattern": null
        }
      },
      "required": true,
      "after_step": "post_the_funds_transfer",
      "sensitivity": "restricted"
    }
  ],
