      "classification": "hard_failure",
      "outcome_code": null,
      "recovery": null,
      "escalate": true,
      "message": "The servicing session expired mid-flow. Re-authenticating unattended is deliberately not automated: it would mean the system holds and replays operator credentials outside the invocation that supplied them. A human re-establishes the session and hands control back."
    },
    {
      "id": "app_error",
      "description": "The servicing subsystem returned a fault page.",
      "detect": {
        "kind": "any_of",
        "of": [
          {
