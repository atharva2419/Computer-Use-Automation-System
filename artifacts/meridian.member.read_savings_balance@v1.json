        "text": "SYSTEM NOTICE",
        "case_sensitive": false
      },
      "classification": "recoverable",
      "outcome_code": null,
      "recovery": {
        "kind": "dismiss_and_retry",
        "dismiss": {
          "described_as": "the Acknowledge button on the system notice interstitial",
          "frame": {
            "kind": "name",
            "value": "main"
          },
          "strategies": [
            {
              "kind": "role_name",
              "role": "button",
              "name": "Acknowledge",
