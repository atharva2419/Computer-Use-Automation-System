{
  "schema_version": "1.0.0",
  "id": "meridian_hosted.member.place_account_hold",
  "version": 1,
  "name": "Place an account hold",
  "description": "Sign on to the MERIDIAN CORE servicing console as supervisor super1. Look up member 102777 by member number and open their record. Open Place Account Hold. Set the share dropdown to 102777-MMKT-27, set the reason dropdown to LEGAL, and type the notes recorded-capability. Every one of those three fields must be set explicitly, including any dropdown that already shows the value you want. Continue to the confirmation screen and apply the hold. Then read back the status of that share.",
  "app": {
    "product": "meridian-hosted",
    "product_version": "v4.2.1",
    "tenant": null,
    "entry_url": "https://web-sample.interface-hiring.com/signon",
    "surface": "legacy_web"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777'.",
      "example": "102777",
      "pattern": "^\\d{6}$",
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "operator_id",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'super1'.",
      "example": "super1",
      "pattern": null,
      "sensitivity": "restricted",
      "secret": false
    },
    {
      "name": "share",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as '102777-MMKT-27'.",
      "example": "102777-MMKT-27",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "reason",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'LEGAL'.",
      "example": "LEGAL",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "notes",
      "type": "string",
      "required": true,
      "description": "Supplied at discovery as 'recorded-capability'.",
      "example": "recorded-capability",
      "pattern": null,
      "sensitivity": "internal",
      "secret": false
    },
    {
      "name": "operator_password",
      "type": "string",
      "required": true,
      "description": "Operator credential.",
      "example": null,
      "pattern": null,
      "sensitivity": "restricted",
      "secret": true
    }
  ],
  "outputs": [
    {
      "name": "share_status",
      "type": "string",
      "description": "",
      "extract": {
        "target": {
          "described_as": "Read the resulting status of the share after the hold was applied",
          "frame": {
            "kind": "top",
            "value": null
          },
          "strategies": [
            {
              "kind": "row_scoped_cell",
              "row_contains": "Share:",
              "cell_index": 1,
              "exact_row_text": false
            }
          ],
          "rationale": "Anchored on the row containing 'Share:' rather than an absolute row index, so inserting or reordering rows does not read the wrong value."
        },
        "source": "text",
        "attribute": null,
        "transform": {
          "kind": "strip",
          "pattern": null
        }
      },
      "required": true,
      "after_step": "apply_the_account_hold",
      "sensitivity": "restricted"
    }
  ],
