# Copy to .env . Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when the key is organisation-scoped rather than tied to a
# single workspace. Such a key does not identify a workspace on its own, so
# the API rejects every request until one is named. Leave blank for a
# workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

CUA_MODEL=claude-sonnet-5
# The planner that picks a capability for a chat message. Defaults to
# CUA_MODEL's value; a smaller model is fine for choosing among a handful
# of named tools.
CUA_CHAT_MODEL=claude-sonnet-5

# The operator the service signs on as. Supplied per invocation and never
# stored; the chatbot's planner is never shown either of these.
CUA_OPERATOR_ID=teller1
CUA_OPERATOR_PASSWORD=password

TARGET_BASE_URL=http://127.0.0.1:5057
